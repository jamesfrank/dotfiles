# general bash shortcuts
if [[ $DF_OS == 'mac' || $DF_OS == 'freebsd' ]]; then
    alias ls='ls -G'
    alias ll='ls -Alh'
    alias la='ls -A'
else
    alias ls='ls --color=auto'
    alias ll='ls -Alh --color=auto'
    alias la='ls -A --color=auto'
fi
alias lc='clear && ls'

alias show='pwd && echo "" && ll'

alias c='clear'

alias ..='cd ..'
alias ...='cd ../..'

alias prettypath='echo "$PATH" | tr ":" "\n"'

# reload bashrc
alias rebash='source $HOME/.bashrc'

# ssh somewhere and then cd to current directory
sshcd() {
    if [ -n "$1" ]; then
        ssh -t "$1" "cd $(printf %q "$PWD"); bash"
    else
        echo "No hostname specified"
    fi
}

# start/reuse an ssh-agent in this shell and load the default key
# (useful in a session whose SSH_AUTH_SOCK isn't set, e.g. a reattached tmux pane)
ssh-load() {
    # ssh-add -l exits >=2 when no agent is reachable; only then start one
    ssh-add -l &>/dev/null
    if [[ $? -ge 2 ]]; then
        eval "$(ssh-agent -s)" >/dev/null
    fi
    if [[ $DF_OS == 'mac' ]]; then
        ssh-add --apple-use-keychain ~/.ssh/id_ed25519
    else
        ssh-add ~/.ssh/id_ed25519
    fi
}

# ring the bell
alias ring-bell="echo -e '\a'"
alias rb='ring-bell'

# safety features
alias mv='mv -i'

# always start tmux in 256 colour mode
alias tmux='tmux -2'

# create or attach to main tmux session
#alias main_tmux='tmux attach -t main || tmux new-session -s main'
alias tm='tmux new -A -s main'

# attach to main tmux session with independent window
alias itm='tmux new-session -t main'
